# Docker 部署配置（复制为 .env）；应用镜像来自 ghcr.io/cyy081021/artex
# 正式版本使用 vX.Y.Z tag；留空或 latest 使用 latest 镜像
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
