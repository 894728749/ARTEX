+# Copy to runtime.env and edit on the recipient machine. Never share runtime.env.
+# Paths below are examples, not the source machine's paths.
+export ARTEX_RUNTIME_ROOT='/path/to/your/artex/runtime'
+export ARTEX_SOURCE_ROOT='/path/to/your/ARTEX'
+export ARTEX_API_BASE='http://localhost:8787'
+# ARTEX_INTEGRATIONS_ROOT is inferred from this bundle by the launcher.
+# export ARTEX_INTEGRATIONS_ROOT='/path/to/this/integrations'
+export ARTEX_NODE='node'
+export ARTEX_WSL_DISTRO='Ubuntu'
+export ARTEX_WINDOWS_PROXY_PORT='7897'
+export ARTEX_PROXY_WAIT_SECONDS='90'
+export ARTEX_POWERSHELL='/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe'
+export ARTEX_WINDOWS_CURL='/mnt/c/Windows/System32/curl.exe'
+export ARTEX_WINDOWS_NODE='/mnt/c/Program Files/nodejs/node.exe'
+# Windows-readable path; default uses wslpath -w on ARTEX_INTEGRATIONS_ROOT.
+# export ARTEX_WINDOWS_INTEGRATIONS_ROOT='C:\path\to\integrations'
+# export ARTEX_PRIVACY_COLLECTOR='C:\path\to\integrations\tools\windows_privacy.ps1'
+# Defaults to the browser installed by the locked Playwright dependency.
+# export ARTEX_PRIVACY_CHROMIUM='/path/to/integrations/browsers/chromium-1247/chrome-linux64/chrome'
+export ARTEX_WINDOWS_EDGE='C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'
+# Optional disabled Burp integration; install and configure separately.
+# export ARTEX_JAVA='java'
+# export ARTEX_BURP_PROXY_JAR='/path/to/mcp-proxy-all.jar'
+# Model credentials belong in your own ARTEX model settings, not this file.
+
